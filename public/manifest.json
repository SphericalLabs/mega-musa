{
  "manifestVersion": 5,
  "id": "io.sphericals.mega-musa",
  "name": "Mega Musa",
  "version": "0.3.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.0.0"
  },
  "requiredPermissions": {
    "localFileSystem": "request",
    "clipboard": "readAndWrite",
    "network": {
      "domains": [
        "https://generativelanguage.googleapis.com",
        "https://api.openai.com"
      ]
    },
    "webview": {
      "allow": "yes",
      "domains": [],
      "allowLocalRendering": "yes",
      "enableMessageBridge": "localOnly"
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "nbpEditorPanel",
      "label": { "default": "Mega Musa" },
      "minimumSize": { "width": 270, "height": 320 },
      "maximumSize": { "width": 900, "height": 2000 },
      "preferredDockedSize": { "width": 340, "height": 900 },
      "preferredFloatingSize": { "width": 380, "height": 900 },
      "icons": [
        {
          "width": 32,
          "height": 32,
          "path": "icons/dark.png",
          "scale": [1, 2],
          "theme": ["dark", "darkest"],
          "species": ["generic"]
        },
        {
          "width": 32,
          "height": 32,
          "path": "icons/light.png",
          "scale": [1, 2],
          "theme": ["light", "lightest"],
          "species": ["generic"]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 23,
      "height": 23,
      "path": "icons/dark.png",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium"],
      "species": ["generic"]
    },
    {
      "width": 23,
      "height": 23,
      "path": "icons/light.png",
      "scale": [1, 2],
      "theme": ["lightest", "light"],
      "species": ["generic"]
    }
  ]
}
