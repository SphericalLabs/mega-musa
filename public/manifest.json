{
  "manifestVersion": 5,
  "id": "com.hgk.nbp.editor",
  "name": "Nano Banana Pro Edit",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.0.0"
  },
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": {
      "domains": ["https://generativelanguage.googleapis.com"]
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "nbpEditorPanel",
      "label": { "default": "Nano Banana Pro Edit" },
      "minimumSize": { "width": 230, "height": 320 },
      "maximumSize": { "width": 900, "height": 2000 },
      "preferredDockedSize": { "width": 320, "height": 600 },
      "preferredFloatingSize": { "width": 360, "height": 660 },
      "icons": [
        {
          "width": 24,
          "height": 24,
          "path": "icons/icon.png",
          "scale": [1, 2],
          "theme": ["darkest", "dark", "medium", "lightest", "light"]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 24,
      "height": 24,
      "path": "icons/icon.png",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium", "lightest", "light"]
    }
  ]
}
