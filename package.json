{
  "name": "nbp-photoshop-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Nano Banana Pro (Gemini 3 Pro Image) edit panel for Adobe Photoshop (UXP).",
  "scripts": {
    "icons": "node scripts/make-icons.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run icons && node esbuild.config.mjs",
    "watch": "npm run icons && node esbuild.config.mjs --watch"
  },
  "dependencies": {
    "fast-png": "^6.2.0",
    "jpeg-js": "^0.4.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "^5.6.0"
  }
}
